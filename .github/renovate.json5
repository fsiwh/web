{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["bun", "gomod", "dockerfile", "docker-compose", "github-actions", "nix", "custom.regex"],
  "nix": { "enabled": true },
  "timezone": "Europe/Berlin",
  "dependencyDashboard": false,
  "automerge": false,
  "groupName": null,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "to {{{newValue}}}",
  "prBodyTemplate": "",
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>npm) depName=(?<depName>\\S+)\\n\\s+\\w+Version = \"(?<currentValue>[^\"]+)\";"]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+)\\n\\s+\\w+Revision = \"(?<currentDigest>[a-f0-9]{40})\";"],
      "currentValueTemplate": "main",
      "versioningTemplate": "regex:^(?<major>0)?main$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yaml$/"],
      "matchStrings": ["renovate-version: '(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)'"],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": ["go run (?<depName>github\\.com/rhysd/actionlint|golang\\.org/x/vuln)/cmd/\\w+@(?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": ["TRIVY_IMAGE: (?<depName>aquasec/trivy):(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["bun", "gomod", "dockerfile", "docker-compose", "github-actions", "nix", "custom.regex"],
      "commitMessageTopic": "{{{replace '^.*/' '' (replace '/v[0-9]+$' '' depName)}}}"
    },
    {
      "matchDepNames": ["conventional-changelog-conventionalcommits"],
      "commitMessageTopic": "conventional-changelog"
    },
    {
      "description": "The native action manager cannot parse renovate-version with a digest; the custom manager handles it.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["ghcr.io/renovatebot/renovate"],
      "enabled": false
    },
    {
      "description": "v0.32+ declares cel.dev/cel-go; sqlc must migrate its imports before the old module path can update.",
      "matchDepNames": ["github.com/google/cel-go"],
      "allowedVersions": "<0.32.0"
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "postUpgradeTasks": {
        "commands": ["node .github/renovate/update-locks.mjs --go"],
        "installTools": { "nix": {}, "golang": {} },
        "executionMode": "branch",
        "fileFilters": ["flake.nix", "flake.lock", "go.mod", "go.sum", "Dockerfile", "internal/database/**", ".github/release/bun.lock"]
      }
    },
    {
      "matchDepNames": ["go", "golang", "nixpkgs"],
      "groupName": "go toolchain"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["flake.nix"],
      "postUpgradeTasks": {
        "commands": ["node .github/renovate/update-locks.mjs --assets"],
        "executionMode": "branch",
        "fileFilters": ["flake.nix"]
      }
    },
    {
      "matchManagers": ["nix"],
      "lockFileMaintenance": { "enabled": true },
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "matchManagers": ["bun"],
      "matchFileNames": [".github/release/**"],
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Indirect major module-path migrations must come from the dependency that imports them.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodUpdateImportPaths", "gomodTidy", "goGenerate"],
      "postUpgradeTasks": {
        "commands": ["node .github/renovate/update-locks.mjs --go"],
        "installTools": { "nix": {}, "golang": {} },
        "executionMode": "branch",
        "fileFilters": ["flake.nix", "go.mod", "go.sum", "Dockerfile", "**/*.go"]
      }
    },
    {
      "matchDepNames": ["nixpkgs", "golang"],
      "postUpgradeTasks": {
        "commands": ["node .github/renovate/update-locks.mjs --go"],
        "installTools": { "nix": {}, "golang": {} },
        "executionMode": "branch",
        "fileFilters": ["flake.nix", "go.mod", "go.sum", "Dockerfile"]
      }
    },
    {
      "matchUpdateTypes": ["digest", "pinDigest"],
      "commitMessageExtra": "from {{#if currentDigest}}{{{currentDigestShort}}}{{else}}{{{currentValue}}}{{/if}} to {{{newDigestShort}}}"
    }
  ]
}
